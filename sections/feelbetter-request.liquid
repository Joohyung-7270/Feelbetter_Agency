{%- comment -%}
  Standalone FeelBetter request section (heading + the request form).
  Used on page.request, password and at the bottom of the home page.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'feelbetter.request.eyebrow' | t
  endif

  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'feelbetter.request.heading' | t
  endif

  assign text = section.settings.text
  assign text_plain = text | strip_html | strip
  if text_plain == blank
    assign text = 'feelbetter.request.text' | t | prepend: '<p>' | append: '</p>'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="{% if section.settings.show_grid %}fb-grid-bg {% endif %}section-{{ section.id }}-padding">
    <div class="page-width">
      <div class="fb-request">
        {%- if eyebrow != blank -%}
          <p class="fb-eyebrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <span class="fb-dot" aria-hidden="true"></span>
            <span>{{ eyebrow | escape_once }}</span>
          </p>
        {%- endif -%}

        <h2 class="fb-request__heading {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ heading | escape_once }}
        </h2>

        {%- if text != blank -%}
          <div class="fb-request__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ text }}
          </div>
        {%- endif -%}

        <div class="fb-request__form{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {% render 'feelbetter-request-form', form_id: section.id %}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FeelBetter request",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Leave the text fields empty: the theme then renders its translated copy (feelbetter.request.*) in every published language."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Empty = translated copy."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = translated copy."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "info": "Empty = translated copy."
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show dotted grid background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "FeelBetter request"
    }
  ]
}
{% endschema %}
