{%- comment -%}
  Collection header, FeelBetter editorial: eyebrow "Collection", serif title,
  description, product count and an "Ask the concierge" link. Optional collection
  image beside the text on desktop. Labels come from feelbetter.plp.*.
{%- endcomment -%}
{%- liquid
  assign root = routes.root_url
  if root == '/'
    assign root = ''
  endif
  assign show_image = false
  if section.settings.show_collection_image and collection.image
    assign show_image = true
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<header class="fb-plp-head color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="fb-plp-head__inner{% if show_image %} fb-plp-head__inner--image{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      <div class="fb-plp-head__text">
        <p class="fb-eyebrow"><span class="fb-dot" aria-hidden="true"></span><span>{{ 'feelbetter.plp.eyebrow' | t }}</span></p>
        <h1 class="fb-plp-head__title h0">
          <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
          {{- collection.title | escape -}}
        </h1>
        {%- if section.settings.show_collection_description and collection.description != blank -%}
          <div class="fb-plp-head__desc rte">{{ collection.description }}</div>
        {%- endif -%}
        <p class="fb-plp-head__meta">
          <span class="fb-mono">{{ 'feelbetter.plp.count' | t: count: collection.all_products_count }}</span>
          <span class="fb-plp-head__sep" aria-hidden="true">·</span>
          <span>
            {{ 'feelbetter.plp.ask_text' | t }}
            <a class="fb-textlink" href="{{ root }}/pages/request">{{ 'feelbetter.plp.ask_link' | t }} <span aria-hidden="true">→</span></a>
          </span>
        </p>
      </div>
      {%- if show_image -%}
        <div class="fb-plp-head__media">
          {{
            collection.image
            | image_url: width: 1600
            | image_tag:
              loading: 'eager',
              sizes: '(min-width: 990px) 40vw, 100vw',
              widths: '400, 600, 800, 1000, 1200, 1600',
              class: 'fb-plp-head__img'
          }}
        </div>
      {%- endif -%}
    </div>
  </div>
</header>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "checkbox",
      "id": "show_collection_description",
      "default": true,
      "label": "t:sections.main-collection-banner.settings.show_collection_description.label"
    },
    {
      "type": "checkbox",
      "id": "show_collection_image",
      "default": false,
      "label": "t:sections.main-collection-banner.settings.show_collection_image.label"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 8
    }
  ]
}
{% endschema %}
