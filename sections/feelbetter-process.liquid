{%- comment -%}
  Process schematic: four nodes, inline SVG connectors, a travelling sunlight dot.
  All copy comes from feelbetter.process.* when the settings are empty.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'feelbetter.process.eyebrow' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'feelbetter.process.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'feelbetter.process.text' | t
  endif
  assign price = section.settings.price
  if price == blank
    assign price = '₩189,000'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <header class="fb-section-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <p class="fb-eyebrow"><span class="fb-dot" aria-hidden="true"></span><span>{{ eyebrow | escape_once }}</span></p>
      <h2 class="fb-section-head__heading {{ section.settings.heading_size }}">{{ heading | escape_once }}</h2>
      {%- if text != blank -%}
        <p class="fb-section-head__text">{{ text | escape_once }}</p>
      {%- endif -%}
    </header>

    <ol class="fb-process" role="list">
      {%- comment -%} 1 · You say it {%- endcomment -%}
      <li class="fb-process__node{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="--i: 0;"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
        <div class="fb-process__head">
          <span class="fb-process__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10l-4.5 3.5V16A2.5 2.5 0 0 1 4 13.5z"/><path d="M8 9h8M8 12h5"/></svg>
          </span>
          <span class="fb-process__index fb-mono" aria-hidden="true">01</span>
        </div>
        <h3 class="fb-process__title">{{ 'feelbetter.process.node_1_title' | t }}</h3>
        <p class="fb-process__text">{{ 'feelbetter.process.node_1_text' | t }}</p>
        {%- if section.settings.show_cards -%}
          <div class="fb-card fb-process__card">
            <span class="fb-card__label fb-mono">{{ 'feelbetter.process.node_1_card_label' | t }}</span>
            <p class="fb-process__bubble">{{ 'feelbetter.process.node_1_message' | t }}</p>
          </div>
        {%- endif -%}
        <span class="fb-process__connector" aria-hidden="true">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="fb-process__line">
            <line class="fb-process__line-h" x1="0" y1="50" x2="100" y2="50" vector-effect="non-scaling-stroke"/>
            <line class="fb-process__line-v" x1="50" y1="0" x2="50" y2="100" vector-effect="non-scaling-stroke"/>
          </svg>
          <i class="fb-process__travel"></i>
        </span>
      </li>

      {%- comment -%} 2 · AI drafts the brief {%- endcomment -%}
      <li class="fb-process__node{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="--i: 1;"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
        <div class="fb-process__head">
          <span class="fb-process__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3h7l5 5v13H7z"/><path d="M14 3v5h5"/><path d="M10 13h6M10 16.5h6M10 9.5h1.5"/></svg>
          </span>
          <span class="fb-process__index fb-mono" aria-hidden="true">02</span>
        </div>
        <h3 class="fb-process__title">{{ 'feelbetter.process.node_2_title' | t }}</h3>
        <p class="fb-process__text">{{ 'feelbetter.process.node_2_text' | t }}</p>
        {%- if section.settings.show_cards -%}
          <div class="fb-card fb-process__card">
            <span class="fb-card__label fb-mono">{{ 'feelbetter.process.node_2_card_label' | t }}</span>
            <dl class="fb-rows">
              <div class="fb-rows__row"><dt class="fb-mono">{{ 'feelbetter.process.brief_item_label' | t }}</dt><dd>{{ 'feelbetter.process.brief_item' | t }}</dd></div>
              <div class="fb-rows__row"><dt class="fb-mono">{{ 'feelbetter.process.brief_style_label' | t }}</dt><dd>{{ 'feelbetter.process.brief_style' | t }}</dd></div>
              <div class="fb-rows__row"><dt class="fb-mono">{{ 'feelbetter.process.brief_ref_label' | t }}</dt><dd>{{ 'feelbetter.process.brief_ref' | t }}</dd></div>
            </dl>
          </div>
        {%- endif -%}
        <span class="fb-process__connector" aria-hidden="true">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="fb-process__line">
            <line class="fb-process__line-h" x1="0" y1="50" x2="100" y2="50" vector-effect="non-scaling-stroke"/>
            <line class="fb-process__line-v" x1="50" y1="0" x2="50" y2="100" vector-effect="non-scaling-stroke"/>
          </svg>
          <i class="fb-process__travel"></i>
        </span>
      </li>

      {%- comment -%} 3 · Concierge verifies {%- endcomment -%}
      <li class="fb-process__node{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="--i: 2;"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
        <div class="fb-process__head">
          <span class="fb-process__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6z"/><path d="M8.8 12.2l2.2 2.2 4.4-4.6"/></svg>
          </span>
          <span class="fb-process__index fb-mono" aria-hidden="true">03</span>
        </div>
        <h3 class="fb-process__title">{{ 'feelbetter.process.node_3_title' | t }}</h3>
        <p class="fb-process__text">{{ 'feelbetter.process.node_3_text' | t }}</p>
        {%- if section.settings.show_cards -%}
          <div class="fb-card fb-process__card">
            <span class="fb-card__label fb-mono">{{ 'feelbetter.process.node_3_card_label' | t }}</span>
            <ul class="fb-checks" role="list">
              {%- assign check_keys = 'check_model,check_seller,check_stock,check_price,check_shipping' | split: ',' -%}
              {%- for key in check_keys -%}
                {%- assign full_key = 'feelbetter.process.' | append: key -%}
                <li class="fb-checks__item">
                  <svg aria-hidden="true" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3.5 8.5l2.8 2.8L12.5 5"/></svg>
                  <span>{{ full_key | t }}</span>
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
        <span class="fb-process__connector" aria-hidden="true">
          <svg viewBox="0 0 100 100" preserveAspectRatio="none" class="fb-process__line">
            <line class="fb-process__line-h" x1="0" y1="50" x2="100" y2="50" vector-effect="non-scaling-stroke"/>
            <line class="fb-process__line-v" x1="50" y1="0" x2="50" y2="100" vector-effect="non-scaling-stroke"/>
          </svg>
          <i class="fb-process__travel"></i>
        </span>
      </li>

      {%- comment -%} 4 · One link, one checkout {%- endcomment -%}
      <li class="fb-process__node fb-process__node--last{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}" style="--i: 3;"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
        <div class="fb-process__head">
          <span class="fb-process__icon fb-process__icon--accent" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M10 14a4 4 0 0 0 5.7 0l2.6-2.6a4 4 0 0 0-5.7-5.7L11.5 6.8"/><path d="M14 10a4 4 0 0 0-5.7 0l-2.6 2.6a4 4 0 0 0 5.7 5.7l1.1-1.1"/></svg>
          </span>
          <span class="fb-process__index fb-mono" aria-hidden="true">04</span>
        </div>
        <h3 class="fb-process__title">{{ 'feelbetter.process.node_4_title' | t }}</h3>
        <p class="fb-process__text">{{ 'feelbetter.process.node_4_text' | t }}</p>
        {%- if section.settings.show_cards -%}
          <div class="fb-card fb-process__card fb-mini-match">
            <p class="fb-mini-match__eyebrow fb-mono"><span class="fb-dot fb-dot--static" aria-hidden="true"></span>{{ 'feelbetter.badges.match_found' | t }}</p>
            <p class="fb-mini-match__product">{{ 'feelbetter.process.match_product' | t }}</p>
            <ul class="fb-badges" role="list">
              <li class="fb-badge fb-badge--verified">{{ 'feelbetter.badges.verified_seller' | t }}</li>
              <li class="fb-badge fb-badge--stock"><span class="fb-badge__dot" aria-hidden="true"></span>{{ 'feelbetter.badges.in_stock' | t }}</li>
            </ul>
            <div class="fb-mini-match__cta">
              <span class="fb-mini-match__price">{{ price | escape_once }}</span>
              <span class="button fb-mini-match__button" aria-hidden="true">{{ 'feelbetter.general.buy_now' | t }}</span>
            </div>
          </div>
        {%- endif -%}
      </li>
    </ol>
  </div>
</div>

{% schema %}
{
  "name": "FeelBetter process",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Four-step schematic. Leave the text fields empty: the theme renders its translated copy (feelbetter.process.*) in every published language."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Empty = translated copy."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = translated copy."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Empty = translated copy."
    },
    {
      "type": "checkbox",
      "id": "show_cards",
      "label": "Show the small data cards under each step",
      "default": true
    },
    {
      "type": "text",
      "id": "price",
      "label": "Sample price on the match card",
      "default": "₩189,000"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "FeelBetter process"
    }
  ]
}
{% endschema %}
