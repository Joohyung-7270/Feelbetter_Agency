{%- comment -%}
  Latest journal articles (home page strip). Picks a blog (default: journal)
  and shows its newest articles as cards. Renders nothing when the blog has
  no articles, except a hint inside the theme editor.
{%- endcomment -%}

{%- liquid
  assign journal = section.settings.blog
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'feelbetter.journal.latest' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'feelbetter.journal.tagline' | t
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- if journal != blank and journal.articles_count > 0 -%}
  <div class="fb-journal-featured color-{{ section.settings.color_scheme }} gradient">
    <div class="{% if section.settings.show_grid %}fb-grid-bg {% endif %}section-{{ section.id }}-padding">
      <div class="page-width">
        <header class="fb-section-head fb-journal-featured__head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <div>
            <p class="fb-eyebrow"><span class="fb-dot" aria-hidden="true"></span><span>{{ 'feelbetter.journal.eyebrow' | t }}</span></p>
            <h2 class="fb-section-head__heading {{ section.settings.heading_size }}">{{ heading | escape_once }}</h2>
            {%- if text != blank -%}
              <p class="fb-section-head__text">{{ text | escape_once }}</p>
            {%- endif -%}
          </div>
          <a class="fb-textlink fb-journal-featured__all" href="{{ journal.url }}">{{ 'feelbetter.journal.all' | t }} <span aria-hidden="true">→</span></a>
        </header>

        <div class="fb-journal__grid fb-journal__grid--3">
          {%- for article in journal.articles limit: section.settings.limit -%}
            <div
              class="fb-journal__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              {% render 'feelbetter-journal-card', article: article, blog: journal, heading_tag: 'h3' %}
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width section-{{ section.id }}-padding">
      <p class="fb-journal__empty-text">{{ 'feelbetter.journal.empty' | t }}</p>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "FeelBetter journal strip",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Newest articles from a blog, as journal cards. Leave the text fields empty: the theme renders its translated copy (feelbetter.journal.*)."
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog",
      "default": "journal"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "label": "Articles to show",
      "default": 3
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = translated copy."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Empty = translated copy."
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show dotted grid background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "FeelBetter journal strip"
    }
  ]
}
{% endschema %}
