{%- comment -%}
  "How it works": four timestamped steps.
  Horizontal timeline on desktop, vertical rail on mobile.
{%- endcomment -%}

{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'feelbetter.steps.heading' | t
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    <div class="fb-steps">
      <header class="fb-steps__header">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fb-eyebrow{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            <span class="fb-dot" aria-hidden="true"></span>
            <span>{{ section.settings.eyebrow | escape }}</span>
          </p>
        {%- endif -%}
        <h2 class="fb-steps__heading {{ section.settings.heading_size }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {{ heading | escape }}
        </h2>
        {%- if section.settings.text != blank -%}
          <div class="fb-steps__text rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
            {{ section.settings.text }}
          </div>
        {%- endif -%}
      </header>

      {%- if section.blocks.size > 0 -%}
        <ol class="fb-steps__list" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign step_time = block.settings.time
              assign step_title = block.settings.title
              assign step_text = block.settings.text
              assign key_base = 'feelbetter.steps.step_' | append: forloop.index
              if step_time == blank
                assign key = key_base | append: '_time'
                assign step_time = key | t
              endif
              if step_title == blank
                assign key = key_base | append: '_title'
                assign step_title = key | t
              endif
              if step_text == blank
                assign key = key_base | append: '_text'
                assign step_text = key | t
              endif
            -%}
            <li
              class="fb-step{% if forloop.last %} fb-step--last{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {{ block.shopify_attributes }}
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
            >
              <span class="fb-step__marker" aria-hidden="true"></span>
              <span class="fb-step__time">{{ step_time | escape }}</span>
              <h3 class="fb-step__title">{{ step_title | escape }}</h3>
              {%- if step_text != blank -%}
                <p class="fb-step__text">{{ step_text | escape }}</p>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FeelBetter steps",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "How it works"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One message. One hour. One link.",
      "info": "Leave empty to use the theme's translated copy."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>AI finds the signal. A human concierge checks the details. You get one link you can trust.</p>"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "time",
          "label": "Timestamp",
          "default": "00:00",
          "info": "Leave empty to use the theme's translated copy for this position."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "You describe it"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Words, a link or a photo. No account, no filters."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FeelBetter steps",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "time": "00:00",
            "title": "You describe it",
            "text": "Words, a link or a photo. No account, no filters."
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "00:01",
            "title": "AI writes the brief",
            "text": "Item, style, reference. The request becomes a sourcing brief."
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "00:10",
            "title": "A concierge sources it",
            "text": "A person checks the model, seller, stock, price and shipping."
          }
        },
        {
          "type": "step",
          "settings": {
            "time": "≤ 60:00",
            "title": "The link is yours",
            "text": "One email. One verified, ready-to-buy link."
          }
        }
      ]
    }
  ]
}
{% endschema %}
