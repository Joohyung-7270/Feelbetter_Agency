{%- comment -%}
  FAQ: four translated question/answer pairs (feelbetter.faq.q1..q4 / a1..a4).
  The same four pairs feed the FAQPage JSON-LD in snippets/feelbetter-seo.liquid
  on the how-it-works page, so what search engines read is what visitors see.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if eyebrow == blank
    assign eyebrow = 'feelbetter.faq.eyebrow' | t
  endif
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'feelbetter.faq.heading' | t
  endif
  assign text = section.settings.text
  if text == blank
    assign text = 'feelbetter.faq.text' | t
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient">
  <div class="{% if section.settings.show_grid %}fb-grid-bg {% endif %}section-{{ section.id }}-padding">
    <div class="page-width">
      <div class="fb-faq">
        <header class="fb-section-head{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <p class="fb-eyebrow"><span class="fb-dot" aria-hidden="true"></span><span>{{ eyebrow | escape_once }}</span></p>
          <h2 class="fb-section-head__heading {{ section.settings.heading_size }}">{{ heading | escape_once }}</h2>
          {%- if text != blank -%}
            <p class="fb-section-head__text">{{ text | escape_once }}</p>
          {%- endif -%}
        </header>

        <div class="fb-faq__list{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- for i in (1..4) -%}
            {%- liquid
              assign q_key = 'feelbetter.faq.q' | append: i
              assign a_key = 'feelbetter.faq.a' | append: i
            -%}
            <details class="fb-faq__item" id="faq-{{ section.id }}-{{ i }}"{% if section.settings.open_first and forloop.first %} open{% endif %}>
              <summary class="fb-faq__question">
                <span class="fb-faq__index fb-mono" aria-hidden="true">0{{ i }}</span>
                <span class="fb-faq__q">{{ q_key | t }}</span>
                <span class="fb-faq__icon" aria-hidden="true">+</span>
              </summary>
              <div class="fb-faq__answer">
                <p>{{ a_key | t }}</p>
              </div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "FeelBetter FAQ",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Four translated questions (feelbetter.faq.*): how long, what it costs, whether an account is needed, paying through an AI assistant. The same answers are published as FAQ structured data on the how-it-works page."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Empty = translated copy."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Empty = translated copy."
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:sections.all.heading_size.options__1.label"
        },
        {
          "value": "h1",
          "label": "t:sections.all.heading_size.options__2.label"
        },
        {
          "value": "h0",
          "label": "t:sections.all.heading_size.options__3.label"
        }
      ],
      "default": "h1",
      "label": "t:sections.all.heading_size.label"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "info": "Empty = translated copy."
    },
    {
      "type": "checkbox",
      "id": "open_first",
      "label": "Open the first question by default",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_grid",
      "label": "Show dotted grid background",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "FeelBetter FAQ"
    }
  ]
}
{% endschema %}
