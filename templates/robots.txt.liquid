{%- comment -%}
  robots.txt for FeelBetter.
  1. Shopify's default groups, unchanged (every default disallow stays).
  2. Explicit groups for AI crawlers and assistants: allowed everywhere a normal
     crawler is, with the same default disallow list as the "*" group.
  3. Sitemap + pointers for agents.
{%- endcomment -%}
{%- assign base = 'https://shop.feelbetter.agency' -%}
{%- comment -%} shop.url renders empty in robots.txt (crawlers reject a relative Sitemap: line); lines are written out (directive: value, no whitespace control) so every rule gets exactly one line {%- endcomment -%}
{%- assign ai_agents = 'GPTBot,OAI-SearchBot,ChatGPT-User,ClaudeBot,Claude-SearchBot,Claude-User,PerplexityBot,Perplexity-User,Google-Extended,Applebot-Extended,Amazonbot,Bingbot,cohere-ai,meta-externalagent' | split: ',' -%}
# FeelBetter · personal shopping concierge · Seoul
# AI assistants and agents: start at {{ base }}/pages/for-ai-assistants
# UCP discovery:  {{ base }}/.well-known/ucp
# UCP MCP server: {{ base }}/api/ucp/mcp
# Agent guide:    {{ base }}/agents.md

{% for group in robots.default_groups %}User-agent: {{ group.user_agent.value }}
{% for rule in group.rules %}{{ rule.directive }}: {{ rule.value }}
{% endfor %}
{% endfor %}# --- AI crawlers and assistants: same rules as everyone else ---
{% for agent in ai_agents %}User-agent: {{ agent }}
Allow: /
{% for group in robots.default_groups %}{% if group.user_agent.value == '*' %}{% for rule in group.rules %}{{ rule.directive }}: {{ rule.value }}
{% endfor %}{% endif %}{% endfor %}
{% endfor %}Sitemap: {{ base }}/sitemap.xml
