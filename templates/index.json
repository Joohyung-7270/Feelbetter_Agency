    "collapsible_content": {
      "type": "collapsible-content",
      "blocks": {
        "faq_1": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What can I request?",
            "icon": "none",
            "row_content": "<p>Almost anything you can describe or point to: something you saw on the street, in a film or on someone's feed. Fashion, design objects, gear, small-batch things. Local and overseas. If it is sold somewhere, we will find where.</p>"
          }
        },
        "faq_2": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How fast?",
            "icon": "none",
            "row_content": "<p>Within 60 minutes of your request during concierge hours. You get one email with one verified link. If something will take longer, we tell you before the hour is up.</p>"
          }
        },
        "faq_3": {
          "type": "collapsible_row",
          "settings": {
            "heading": "What does the AI do?",
            "icon": "none",
            "row_content": "<p>It reads your request and turns it into a structured sourcing brief: item, style, reference, constraints. Then a human concierge takes over to check the model, seller, stock, price and shipping. AI finds the signal. A person checks the details.</p>"
          }
        },
        "faq_4": {
          "type": "collapsible_row",
          "settings": {
            "heading": "How do I buy?",
            "icon": "none",
            "row_content": "<p>Your email links to a ready-to-buy page in this store. Tap Buy now, pay with the methods you already use, and we handle the sourcing and shipping. One item, one checkout.</p>"
          }
        },
        "faq_5": {
          "type": "collapsible_row",
          "settings": {
            "heading": "Which languages?",
            "icon": "none",
            "row_content": "<p>English, Korean, Japanese, Chinese, Spanish, German and French. Write in whichever you like. Your link arrives in the same language.</p>"
          }
        }
      },
      "block_order": [
